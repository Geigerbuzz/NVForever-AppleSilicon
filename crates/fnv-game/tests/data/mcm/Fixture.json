{
	"modName": "FixtureMod",
	"displayName": "$modDisplayName",
	"description": "$modDescription",
	"saveFile": "Fixture.ini",
	"minMCMVersion": 1.30,
	"minModVersion": 1.00,
	"requirements": [
		{ "type": "plugin", "file": "Fixture.esp" },
		{ "type": "file", "file": "Config/Fixture/Fixture.ini" }
	],
	"submenus": {
		"0": {
			"listTitle": "$modDisplayName",
			"pageTitle": "$modDisplayName",
			"active": 1,
			"columns": 1,
			"enable": 1,
			"options": {
				"1": {
					"title": "",
					"enable": 1,
					"type": 0,
					"image": {
						"filename": "Interface/Fixture/Splash.dds",
						"width": 700,
						"height": 350,
						"offsetX": 0,
						"offsetY": 0,
						"systemcolor": 0
					}
				}
			}
		},
		"1": {
			"listTitle": "$General",
			"pageTitle": "$General",
			"columns": 2,
			"enable": 1,
			"state": { "form": "Goo1", "auxVar": "*_FixtureState", "key": 0, "value": 1 },
			"options": {
				"1": { "title": "$Heading", "enable": 1, "type": 0 },
				"2": {
					"title": "$TheList",
					"enable": 1,
					"type": 1,
					"mouse": "$TheListMouse",
					"strings": [ "$Off", "$Middle", "$Most" ],
					"vars": [ { "form": "FixtureQuestScript", "numVar": "iList", "configINI": "General:iList", "default": 1 } ]
				},
				"3": {
					"title": "$TheSlider",
					"enable": 1,
					"type": 2,
					"suffix": "%",
					"mouse": "$TheSliderMouse",
					"vars": [ { "form": "PlayerREF", "auxVar": "*_iChance", "key": 0, "configINI": "General:iChance", "default": 30 } ],
					"scale": { "valueDecimal": 0, "valueIncrement": 1, "valueMin": 1, "valueMax": 100 },
					"call": { "type": "udf", "value": "FixtureUpdate" }
				},
				"4": {
					"title": "$TheDecimal",
					"enable": 1,
					"type": 2.5,
					"suffix": "x",
					"vars": [ { "form": "Goo1", "auxVar": "*Fixture_INI", "key": 1, "configINI": "Tuning:fDec", "default": 0.4 } ],
					"scale": { "valueDecimal": 1, "valueIncrement": 0.1, "valueMin": -3, "valueMax": 3, "suffix": "x" }
				},
				"5": {
					"title": "$TheCheckbox",
					"enable": 1,
					"type": 4,
					"vars": [ { "form": "PlayerREF", "auxVar": "*_bBox", "key": 0, "configINI": "Tuning:bBox", "default": 1 } ],
					"Call": { "type": "udf", "value": "FixtureUpdate" }
				},
				"6": {
					"title": "$TheToggle",
					"enable": 1,
					"type": 5,
					"vars": [ { "form": "Goo1", "auxVar": "*_Toggle", "key": 0, "configINI": "Tuning:bToggle", "default": 0 } ]
				},
				"7": {
					"title": "$TheLabelled",
					"enable": 1,
					"type": 6,
					"textOff": "$Far",
					"textOn": "$Near",
					"vars": [ { "form": "Goo1", "auxVar": "*_Labelled", "key": 4, "configINI": "Tuning:bLabelled", "default": 1 } ]
				},
				"8": {
					"title": "$TheKey",
					"enable": 1,
					"type": 3,
					"vars": [ { "uiTrait": "HUDMainMenu/_Fixture+Key", "configINI": "Tuning:iKey", "default": 0 } ]
				},
				"9": {
					"title": "$TheUnknown",
					"enable": 1,
					"type": 8,
					"vars": [ { "configINI": "Tuning:iUnknown", "default": 0 } ]
				}
			}
		}
	}
}
